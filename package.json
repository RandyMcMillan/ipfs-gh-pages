{
  "name": "helio-ipfs-github-pages",
  "private": true,
  "version": "1.7.5",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-car.mjs",
    "preview": "vite preview",
    "test": "npm run test:all",
    "test:all": "node --test tests/unit.test.mjs && node --test tests/car.test.mjs && node tests/cdp-test.mjs && node tests/cdp-eval.mjs && node tests/cdp-zip.mjs && node tests/cdp-download.mjs && node tests/cdp-connect.mjs && node tests/cdp-share-link.mjs && node tests/cdp-ui.mjs && node tests/cdp-ipns-chip.mjs",
    "test:verbose": "VERBOSE=1 npm run test:all",
    "test:deployed": "TEST_URL=https://randymcmillan.github.io/ipfs-gh-pages/ npm run test:all",
    "test:unit": "node --test tests/unit.test.mjs",
    "ci:chrome": "node scripts/ci-chrome.mjs",
    "test:ci": "node scripts/test-e2e.mjs",
    "test:download": "node tests/cdp-download.mjs",
    "test:eval": "node tests/cdp-eval.mjs",
    "test:zip": "node tests/cdp-zip.mjs",
    "test:connect": "node tests/cdp-connect.mjs",
    "test:share": "node tests/cdp-share-link.mjs",
    "kubo:browser": "node scripts/kubo-config-browser.mjs",
    "kubo:ws": "node scripts/kubo-config-ws.mjs",
    "kubo:wss": "node scripts/kubo-config-wss.mjs",
    "kubo:webrtc": "node scripts/kubo-config-webrtc.mjs",
    "kubo:id": "node scripts/kubo-rpc-id.mjs",
    "cert:generate": "node scripts/cert-generate.mjs",
    "proxy:wss": "node scripts/wss-proxy.mjs",
    "test:gateway": "node --test tests/gateway.test.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@chainsafe/libp2p-gossipsub": "^14.1.2",
    "@helia/strings": "^4.0.0",
    "@helia/unixfs": "^5.0.0",
    "@helia/verified-fetch": "^2.0.0",
    "@libp2p/pubsub-peer-discovery": "^12.0.0",
    "@multiformats/multiaddr": "^12.0.0",
    "@primer/css": "^22.3.3",
    "fflate": "^0.8.0",
    "helia": "^5.0.0"
  },
  "devDependencies": {
    "vite": "^5.0.0"
  }
}
